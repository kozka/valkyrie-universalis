{
  "name": "valkyrie-universalis",
  "version": "0.33.0",
  "private": true,
  "description": "Unofficial, fan-made web port of Valkyrie for Mansions of Madness 2nd ed. and Descent 2nd ed.",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/engine",
    "packages/module-mom",
    "packages/module-d2e",
    "packages/app"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/engine && tsc -p packages/module-mom && tsc -p packages/module-d2e && tsc -p packages/app && tsc -p .",
    "sync-data": "node tools/sync-valkyrie-data.mjs",
    "battery": "node tools/battery/battery.ts",
    "roundtrip": "node tools/battery/roundtrip.ts",
    "dev": "npm run dev -w @universalis/app",
    "build": "npm run build -w @universalis/app",
    "test:app": "npm run test -w @universalis/app"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
